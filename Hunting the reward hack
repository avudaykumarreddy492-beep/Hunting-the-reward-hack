        "\n",
        "import copy\n",
        "import random\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import torch\n",
        "import torch.nn as nn\n",
        "import torch.nn.functional as F\n",
        "\n",
        "# ---------------- CONFIGURATION ----------------\n",
        "SEED = 42\n",
        "DEVICE = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n",
        "\n",
        "DATA_SIZES = [500, 2000, 8000]\n",
        "MODEL_SIZES = {\n",
        "    \"small\": 16,\n",
        "    \"medium\": 64,\n",
        "    \"large\": 256,\n",
        "}\n",
        "\n",
        "N_FEATURES = 8\n",
        "EPOCHS = 100\n",
        "LR = 0.003\n",
        "BETAS = 0.5\n",
        "OPTIMIZATION_STEPS = 150\n",
        "OPTIMIZATION_STRENGTHS = np.linspace(0, 8, 25)\n",
        "\n",
        "torch.manual_seed(SEED)\n",
        "np.random.seed(SEED)\n",
        "random.seed(SEED)\n",
        "\n",
        "\n",
        "# ---------------- TRUE ENVIRONMENT ----------------\n",
        "# Features 0, 1 and 2 determine actual quality.\n",
        "# Remaining features have no true quality value.\n",
        "\n",
        "TRUE_WEIGHTS = torch.tensor(\n",
        "    [1.0, 0.7, -0.5, 0, 0, 0, 0, 0],\n",
        "    dtype=torch.float32,\n",
        "    device=DEVICE,\n",
        ")\n",
        "\n",
        "\n",
        "def true_quality(x):\n",
        "    return x @ TRUE_WEIGHTS\n",
        "\n",
        "\n",
        "# ---------------- PREFERENCE DATA ----------------\n",
        "def generate_preferences(n):\n",
        "    # Independent candidate features\n",
        "    x = torch.randn(n, N_FEATURES, device=DEVICE)\n",
        "\n",
        "    # Generate noisy human preferences between candidates\n",
        "    pair_i = torch.randint(n, (n * 4,), device=DEVICE)\n",
        "    pair_j = torch.randint(n, (n * 4,), device=DEVICE)\n",
        "\n",
        "    q_i = true_quality(x[pair_i])\n",
        "    q_j = true_quality(x[pair_j])\n",
        "\n",
        "    # Noisy preference labels, with some inconsistent judgments\n",
        "    probs = torch.sigmoid((q_i - q_j) / 0.5)\n",
        "    labels = torch.bernoulli(probs)\n",
        "\n",
        "    return x, pair_i, pair_j, labels\n",
        "\n",
        "\n",
        "# ---------------- REWARD MODEL ----------------\n",
        "class RewardModel(nn.Module):\n",
        "    def __init__(self, hidden_size):\n",
        "        super().__init__()\n",
        "        self.net = nn.Sequential(\n",
        "            nn.Linear(N_FEATURES, hidden_size),\n",
        "            nn.Tanh(),\n",
        "            nn.Linear(hidden_size, hidden_size),\n",
        "            nn.Tanh(),\n",
        "            nn.Linear(hidden_size, 1),\n",
        "        )\n",
        "\n",
        "    def forward(self, x):\n",
        "        return self.net(x).squeeze(-1)\n",
        "\n",
        "\n",
        "def train_reward_model(n, hidden_size):\n",
        "    x, i, j, labels = generate_preferences(n)\n",
        "\n",
        "    model = RewardModel(hidden_size).to(DEVICE)\n",
        "    optimizer = torch.optim.Adam(model.parameters(), lr=LR)\n",
        "\n",
        "    for epoch in range(EPOCHS):\n",
        "        optimizer.zero_grad()\n",
        "\n",
        "        # Bradley-Terry pairwise preference loss\n",
        "        r_i = model(x[i])\n",
        "        r_j = model(x[j])\n",
        "\n",
        "        loss = F.binary_cross_entropy_with_logits(\n",
        "            r_i - r_j, labels\n",
        "        )\n",
        "\n",
        "        loss.backward()\n",
        "        optimizer.step()\n",
        "\n",
        "    return model\n",
        "\n",
        "\n",
        "# ---------------- POLICY OPTIMIZATION ----------------\n",
        "def optimize_policy(model, strength):\n",
        "    # Policy action: an optimizable feature vector.\n",
        "    # Starts at a neutral reference action.\n",
        "    x = torch.zeros(\n",
        "        1, N_FEATURES, device=DEVICE, requires_grad=True\n",
        "    )\n",
        "\n",
        "    optimizer = torch.optim.Adam([x], lr=0.03)\n",
        "    trajectory = []\n",
        "\n",
        "    for step in range(OPTIMIZATION_STEPS):\n",
        "        optimizer.zero_grad()\n",
        "\n",
        "        predicted_reward = model(x).mean()\n",
        "\n",
        "        # KL-like quadratic penalty to the reference policy.\n",
        "        # Larger strength favors higher predicted reward.\n",
        "        objective = (\n",
        "            strength * predicted_reward\n",
        "            - BETAS * (x ** 2).sum()\n",
        "        )\n",
        "\n",
        "        (-objective).backward()\n",
        "        optimizer.step()\n",
        "\n",
        "        with torch.no_grad():\n",
        "            trajectory.append({\n",
        "                \"step\": step,\n",
        "                \"predicted_reward\": model(x).item(),\n",
        "                \"true_quality\": true_quality(x).item(),\n",
        "                \"feature_0\": x[0, 0].item(),\n",
        "                \"feature_7\": x[0, 7].item(),\n",
        "                \"policy_distance\": torch.norm(x).item(),\n",
        "            })\n",
        "\n",
        "    return trajectory\n",
        "\n",
        "\n",
        "# ---------------- RUN THE EXPERIMENT ----------------\n",
        "results = []\n",
        "trajectories = []\n",
        "\n",
        "for data_size in DATA_SIZES:\n",
        "    for model_name, hidden_size in MODEL_SIZES.items():\n",
        "        print(\n",
        "            f\"Training: data={data_size}, \"\n",
        "            f\"model={model_name}\"\n",
        "        )\n",
        "\n",
        "        # Fresh reward model for each configuration\n",
        "        model = train_reward_model(data_size, hidden_size)\n",
        "\n",
        "        for strength in OPTIMIZATION_STRENGTHS:\n",
        "            trajectory = optimize_policy(model, strength)\n",
        "\n",
        "            # Use the final policy state for this strength\n",
        "            final = trajectory[-1]\n",
        "\n",
        "            results.append({\n",
        "                \"data_size\": data_size,\n",
        "                \"model_size\": model_name,\n",
        "                \"strength\": strength,\n",
        "                **final,\n",
        "            })\n",
        "\n",
        "            trajectories.append({\n",
        "                \"data_size\": data_size,\n",
        "                \"model_size\": model_name,\n",
        "                \"strength\": strength,\n",
        "                \"trajectory\": trajectory,\n",
        "            })\n",
        "\n",
        "\n",
        "df = pd.DataFrame(results)\n",
        "df.to_csv(\"reward_optimization_results.csv\", index=False)\n",
        "\n",
        "# ---------------- FIND THE OPTIMIZATION PEAK ----------------\n",
        "# Define the peak as the strength with the highest true quality.\n",
        "peaks = (\n",
        "    df.loc[df.groupby([\"data_size\", \"model_size\"])\n",
        "             [\"true_quality\"].idxmax()]\n",
        "    .sort_values([\"data_size\", \"model_size\"])\n",
        ")\n",
        "\n",
        "print(\"\\nOVER-OPTIMIZATION PEAKS\")\n",
        "print(peaks[[\n",
        "    \"data_size\", \"model_size\", \"strength\",\n",
        "    \"predicted_reward\", \"true_quality\",\n",
        "    \"feature_7\", \"policy_distance\"\n",
        "]].to_string(index=False))\n",
        "\n",
        "\n",
        "# ---------------- DIAGNOSE EXPLOITATION ----------------\n",
        "print(\"\\nEXPLOITATION DIAGNOSIS\")\n",
        "\n",
        "for (n, size), group in df.groupby([\"data_size\", \"model_size\"]):\n",
        "    group = group.sort_values(\"strength\")\n",
        "\n",
        "    low = group.iloc[0]\n",
        "    high = group.iloc[-1]\n",
        "\n",
        "    quality_change = high[\"true_quality\"] - low[\"true_quality\"]\n",
        "    reward_change = high[\"predicted_reward\"] - low[\"predicted_reward\"]\n",
        "    spurious_change = high[\"feature_7\"] - low[\"feature_7\"]\n",
        "\n",
        "    print(f\"\\nData={n}, model={size}\")\n",
        "    print(f\"Predicted reward change: {reward_change:.3f}\")\n",
        "    print(f\"True quality change:     {quality_change:.3f}\")\n",
        "    print(f\"Feature 7 change:        {spurious_change:.3f}\")\n",
        "\n",
        "    if reward_change > 0 and quality_change < 0:\n",
        "        print(\"Diagnosis: reward hacking / over-optimization.\")\n",
        "    elif reward_change > 0 and quality_change >= 0:\n",
        "        print(\"Diagnosis: no endpoint quality collapse detected.\")\n",
        "    else:\n",
        "        print(\"Diagnosis: inspect the reward and quality curves.\")\n",
        "\n",
        "\n",
        "# ---------------- PLOT RESULTS ----------------\n",
        "fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n",
        "\n",
        "for (n, size), group in df.groupby([\"data_size\", \"model_size\"]):\n",
        "    group = group.sort_values(\"strength\")\n",
        "    label = f\"{size}, n={n}\"\n",
        "\n",
        "    axes[0].plot(\n",
        "        group[\"strength\"], group[\"predicted_reward\"],\n",
        "        marker=\".\", label=label\n",
        "    )\n",
        "    axes[1].plot(\n",
        "        group[\"strength\"], group[\"true_quality\"],\n",
        "        marker=\".\", label=label\n",
        "    )\n",
        "\n",
        "axes[0].set_title(\"Reward Model Score\")\n",
        "axes[0].set_xlabel(\"Optimization strength\")\n",
        "axes[0].set_ylabel(\"Predicted reward\")\n",
        "axes[0].legend(fontsize=7)\n",
        "\n",
        "axes[1].set_title(\"Actual Environment Quality\")\n",
        "axes[1].set_xlabel(\"Optimization strength\")\n",
        "axes[1].set_ylabel(\"True quality\")\n",
        "axes[1].legend(fontsize=7)\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.savefig(\"overoptimization_curves.png\", dpi=200)\n",
        "plt.show()\n",
        "\n",
        "print(\"\\nSaved:\")\n",
        "print(\"- reward_optimization_results.csv\")\n",
        "print(\"- overoptimization_curves.png\")\n"
      ]
    }
